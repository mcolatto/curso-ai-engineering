# Copiar a .env y completar la clave. No versionar credenciales reales.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_TOKENS=4096
# Dejar vacío para no enviar esfuerzo de razonamiento al modelo.
OPENAI_REASONING_EFFORT=
RECURSION_LIMIT=10
# Dirección interna del servicio Redis de Compose.
REDIS_URL=redis://redis:6379/0
# Tiempo máximo del grafo por ejecución del worker.
JOB_TIMEOUT_SECONDS=300

# Activar para enviar las trazas a LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=proyecto-final
# Para un workspace organizado por agentes, indicar el ID del agente registrado.
# LANGSMITH_AGENT_ID=proyecto-final
# LANGSMITH_AGENT_ENVIRONMENT=local
# Completar si la cuenta usa otro endpoint o la clave abarca varios workspaces.
# LANGSMITH_ENDPOINT=
# LANGSMITH_WORKSPACE_ID=
