# Copiar este archivo como .env y completar la clave de OpenAI; el modelo es opcional.
# No incluir claves reales en este archivo ni versionar .env.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Dejar vacío si el modelo no admite esfuerzo de razonamiento.
OPENAI_REASONING_EFFORT=low

# Límite de tokens de salida y timeout de red en segundos.
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
